{
 "name": "Lecteur DX7 · moteur Dexed",
 "short_name": "DX7 Lecteur",
 "description": "Écoute, notation et classement de banques DX7 (.syx) avec le moteur Dexed.",
 "lang": "fr",
 "start_url": "./index.html",
 "scope": "./",
 "display": "standalone",
 "orientation": "any",
 "background_color": "#171618",
 "theme_color": "#171618",
 "categories": [
  "music",
  "utilities"
 ],
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icon-maskable.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "file_handlers": [
  {
   "action": "./index.html",
   "accept": {
    "application/octet-stream": [
     ".syx"
    ],
    "application/json": [
     ".json"
    ],
    "text/plain": [
     ".txt"
    ]
   }
  }
 ]
}